# Copy real values into Vercel: Project -> Settings -> Environment Variables.
# Never commit an actual .env.local file with real keys.

# Stripe test-mode secret key (Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_...

# Recurring Price ID for the Travel Advice Pro €5/month plan
# (Products -> create a product -> add a recurring EUR 5.00/month price)
STRIPE_PRICE_TRAVEL_ADVICE=price_...

# Webhook signing secret (Developers -> Webhooks -> your endpoint -> Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional fallback if the Origin header isn't present; usually not needed
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
